[Unit]
Description=Cuánto dura: descarga los datos nuevos de la DGT, recalcula, valida y publica
Documentation=https://github.com/amintikk/cuantodura
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/home/ubuntu/.t3/projects/cuantodura
ExecStart=/home/ubuntu/.t3/projects/cuantodura/pipeline/update.sh
Nice=10
IOSchedulingClass=idle
MemoryMax=6G
TimeoutStartSec=3h
